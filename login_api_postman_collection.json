{
	"info": {
		"_postman_id": "c1f2e3d4-b5a6-4c7d-8e9f-a0b1c2d3e4f5",
		"name": "CRM Project User API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "User Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "authorizations",
								"value": "{{default_auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/user/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"user",
								"login"
							]
						},
						"description": "User login API with email and password in body and authorizations key in header (pre-login token)."
					},
					"response": []
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "authorizations",
								"value": "{{user_jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"oldPassword\": \"password123\",\n    \"newPassword\": \"newSecurePassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/user/change-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"user",
								"change-password"
							]
						},
						"description": "Change user password API. Requires JWT token in authorizations header."
					},
					"response": []
				}
			]
		},
		{
			"name": "User Management",
			"item": [
				{
					"name": "Add or Edit Manager",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "authorizations",
								"value": "{{user_jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1, \n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"email\": \"manager@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/user/add-or-edit-manager",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"user",
								"add-or-edit-manager"
							]
						},
						"description": "Common API to add or edit a manager. Include 'id' for edit, omit for add. Admin only."
					},
					"response": []
				},
				{
					"name": "Add or Edit Agent",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "authorizations",
								"value": "{{user_jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1,\n    \"first_name\": \"Jane\",\n    \"last_name\": \"Smith\",\n    \"email\": \"agent@example.com\",\n    \"fk_manager_id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/user/add-or-edit-agent",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v1",
								"user",
								"add-or-edit-agent"
							]
						},
						"description": "Common API to add or edit an agent. Include 'id' for edit, omit for add. Admin only."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "default_auth_token",
			"value": "@#Slsjpoq$S1o08#MnbAiB%UVUV&Y*5EU@exS1o!08L9TSlsjpo#FKDFJSDLFJSDLFJSDLFJSDQY",
			"type": "string"
		},
		{
			"key": "user_jwt_token",
			"value": "your_jwt_token_here",
			"type": "string"
