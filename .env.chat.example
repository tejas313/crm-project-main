# ==========================================
# Gupshup WhatsApp Configuration
# Add these variables to your .env file
# ==========================================

# Gupshup API Key (from Gupshup Dashboard)
GUPSHUP_API_KEY=your_gupshup_api_key_here

# Gupshup App Name (from Gupshup Dashboard)
GUPSHUP_APP_NAME=your_gupshup_app_name_here

# Gupshup Source Number (your WhatsApp Business number registered with Gupshup)
# Format: country code + number without + (e.g., 919876543210)
GUPSHUP_SOURCE_NUMBER=919876543210

# Gupshup API URL (default: https://api.gupshup.io/wa/api/v1/msg)
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg

# ==========================================
# Gupshup Webhook Configuration
# Configure these URLs in your Gupshup Dashboard:
# ==========================================
# Inbound Message Webhook: https://your-domain.com/v1/chat/webhook/inbound
# Message Status Webhook:  https://your-domain.com/v1/chat/webhook/status
